FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install --no-install-recommends -y \
    python3.10 python3-pip vim make curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

ENV PATH="/home/.venv/bin:/root/.local/bin:$PATH" \
    UV_PROJECT_ENVIRONMENT=/home/.venv \
    RFANTIBODY_ROOT=/home \
    RFANTIBODY_WEIGHTS=/home/weights \
    RFANTIBODY_SCRIPTS=/home/scripts \
    PYTHONPATH=/home/src:/home/include/SE3Transformer:/home/include/antifold

WORKDIR /home

# Copy project into the same layout expected by the original scripts.
COPY pyproject.toml uv.lock README.md LICENSE /home/
COPY src /home/src
COPY scripts /home/scripts
COPY include /home/include
COPY test /home/test
COPY weights /home/weights

# Install the complete project environment during build.
RUN uv sync --frozen --all-extras

# Fail fast with an explicit hint when the local weights directory was not prepared.
RUN test -s /home/weights/RFdiffusion_Ab.pt \
    && test -s /home/weights/ProteinMPNN_v48_noise_0.2.pt \
    && test -s /home/weights/RF2_ab.pt \
    && test -s /home/weights/RFab_noframework-nosidechains-5-10-23_trainingparamsadded.pt \
    && test -s /home/weights/antifold_model.pt \
    || (echo "Missing weights in local build context. Run 'bash include/download_weights.sh' before building Dockerfile.prod." >&2; exit 1)

ENTRYPOINT /bin/bash